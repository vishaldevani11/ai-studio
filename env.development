SUPPORT_EMAIL=support@example.com

# Monitoring (Optional)
MONITORING_API_KEY=mock-monitoring-key

# Feature Flags
FEATURES_ADVANCED_ANALYTICS=false
FEATURES_BATCH_IMAGE_PROCESSING=false
FEATURES_CUSTOM_INTEGRATIONS=false
FEATURES_WHITE_LABEL=false
FEATURES_NEW_IMAGE_MODEL=false
FEATURES_BETA_FEATURES=false

# Security
IP_WHITELIST=
